<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration du service d'accessibilité du plugin ussd_launcher.

  Sans ce fichier ET sans la déclaration <service> dans AndroidManifest.xml,
  Android n'instancie jamais UssdAccessibilityService : les écrans USSD ne sont
  pas captés, `serviceReady` reste false et chaque session s'arrête sur
  « Service d'accessibilité de l'app serveur désactivé ».

  On reprend la configuration du plugin en retirant `android:settingsActivity`,
  qui pointait vers une classe inexistante (com.example.android...).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_service_description"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFlags="flagReportViewIds"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="true" />
