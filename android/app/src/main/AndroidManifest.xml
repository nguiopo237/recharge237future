<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ──────────────────────────────────────────────────────────── -->
    <!-- RÉSEAU / INTERNET                                            -->
    <!-- ──────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ──────────────────────────────────────────────────────────── -->
    <!-- TÉLÉPHONE / SIM / USSD                                       -->
    <!-- ──────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <!-- ──────────────────────────────────────────────────────────── -->
    <!-- SMS                                                          -->
    <!-- ──────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.BROADCAST_SMS" />

    <!-- ──────────────────────────────────────────────────────────── -->
    <!-- SERVICE EN ARRIÈRE-PLAN                                      -->
    <!-- ──────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- [28/10/2026] Type specialUse, cf. la déclaration du service plus bas. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- [RESEAU 28/10/2026] Cycle « mode avion » de récupération réseau
         (lib/service/server/network_recovery.dart → MainActivity.airplaneCycle).
         Permission réservée : elle ne s'obtient pas par une fenêtre Android mais
         par une commande adb unique sur chaque téléphone serveur :
           adb shell pm grant com.recharge237.serveur android.permission.WRITE_SECURE_SETTINGS
         Sans elle, le cycle est refusé par le système et l'app le signale à
         l'admin au lieu de laisser le téléphone sans réseau. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ──────────────────────────────────────────────────────────── -->
    <!-- NOTIFICATIONS (Android 13+)                                  -->
    <!-- ──────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- [RENOMMAGE 29/10/2026] Proposer la désinstallation de l'ancienne
         version (com.example.projettest), qui sinon continuerait à prendre
         des commandes en parallèle. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:label="ServeurApp Recharge237"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ── Flutter Background Service ────────────────────────── -->
        <!--
          [FIX 28/10/2026] Android 15 limite à 6 h par jour cumulées les
          services de premier plan de type « dataSync ». Une fois ce quota
          épuisé, `startForeground` lève ForegroundServiceStartNotAllowedException
          et l'application CRASHE au démarrage (constaté le 28/10 à 04:03 sur
          le téléphone serveur). Un serveur de livraison doit tourner en
          continu : le type « specialUse » n'a pas cette limite et correspond
          au cas prévu par Android pour un service métier permanent.
        -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false"
            tools:replace="android:exported,android:foregroundServiceType">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Serveur de livraison de recharges USSD actif en permanence" />
        </service>

        <!-- ── Redémarrage automatique après reboot ───────────────── -->
        <receiver
            android:name="id.flutter.flutter_background_service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- [29/10/2026] Récepteur du paquet `telephony` retiré avec lui : la
             classe n'existe plus, Android plantait l'app à chaque SMS reçu.
             Les SMS passent désormais par MainActivity (canal r237/sms). -->

        <!-- ── Service d'accessibilité : lecture des menus USSD ─────── -->
        <!--
          Indispensable : MainActivity appelle UssdAccessibilityService
          (canal r237/ussd : dial / reply / cancel / serviceReady). Sans cette
          déclaration, le service n'est jamais instancié par Android, aucune
          réponse USSD n'est captée et toute session échoue avant même de
          composer le code.
        -->
        <service
            android:name="com.kavina.ussd_launcher.UssdAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/r237_ussd_accessibility" />
        </service>

        <!-- Flutter embedding meta-data -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <queries>
        <!-- [RENOMMAGE 29/10/2026] Détecter l'ancienne version de l'app. -->
        <package android:name="com.example.projettest" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Permet de lancer l'écran de paramètres d'accessibilité -->
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS"/>
        </intent>
    </queries>

</manifest>
